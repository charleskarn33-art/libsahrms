# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email delivery — Resend is preferred and used whenever RESEND_API_KEY is set.
# Until a sending domain is verified with Resend, set the GMAIL_* vars below
# instead as a fallback (SMTP via a Gmail App Password). Leave RESEND_API_KEY
# unset while using Gmail; adding it later switches providers automatically.
RESEND_API_KEY=
RESEND_FROM_EMAIL="LIBSA Payroll <payroll@libsaconsultancy.com>"

# Gmail SMTP fallback (used only if RESEND_API_KEY is not set)
# GMAIL_APP_PASSWORD requires 2-Step Verification enabled on the account:
# https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME="LIBSA Payroll"

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_NAME="LIBSA Consultancy"
